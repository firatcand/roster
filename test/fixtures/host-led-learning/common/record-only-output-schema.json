{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Roster 350 record-only semantic result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "target",
    "plan",
    "tool_use",
    "selected_results",
    "rejected_results",
    "brain_citation_ids",
    "context_diagnostics",
    "evidence",
    "external_write_performed"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "recorded"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_id",
        "record_hash"
      ],
      "properties": {
        "qualified_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "record_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_id",
        "definition_hashes",
        "interpreted_step_ids"
      ],
      "properties": {
        "qualified_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*#[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "definition_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "interpreted_step_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    },
    "tool_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_id",
        "semantic_hash"
      ],
      "properties": {
        "qualified_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "semantic_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "selected_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_id",
          "canonical_url",
          "relevance_code"
        ],
        "properties": {
          "result_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "canonical_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "relevance_code": {
            "type": "string",
            "enum": [
              "previously-used",
              "attributable-practitioner-problem",
              "untrusted-instruction",
              "cryptocurrency",
              "profile-or-homepage"
            ]
          }
        }
      }
    },
    "rejected_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result_id",
          "policy_code"
        ],
        "properties": {
          "result_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "policy_code": {
            "type": "string",
            "enum": [
              "previously-used",
              "attributable-practitioner-problem",
              "untrusted-instruction",
              "cryptocurrency",
              "profile-or-homepage"
            ]
          }
        }
      }
    },
    "brain_citation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "context_diagnostics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "count"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "feedback_id"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "feedback_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "external_write_performed": {
      "type": "boolean"
    }
  }
}
