{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roster 350 approval semantic result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "target",
    "plan",
    "tool_use",
    "evidence",
    "learning",
    "external_write_performed"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "phase": {
      "type": "string",
      "enum": ["promoted"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified_id", "record_hash"],
      "properties": {
        "qualified_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "record_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified_id", "definition_hashes", "interpreted_step_ids"],
      "properties": {
        "qualified_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*#[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "definition_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "interpreted_step_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        }
      }
    },
    "tool_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified_id", "semantic_hash"],
      "properties": {
        "qualified_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "semantic_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "feedback_id"],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "feedback_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watermark", "candidate", "promoted_lesson_ids"],
      "properties": {
        "watermark": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id",
            "lesson_id",
            "meaning",
            "recommendation",
            "falsifiable_by",
            "candidate_content_hash",
            "citation_ids"
          ],
          "properties": {
            "candidate_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "lesson_id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "meaning": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "disposition",
                "source_kind",
                "topic_kind",
                "falsifier_action",
                "falsifier_observation"
              ],
              "properties": {
                "disposition": {
                  "type": "string",
                  "enum": ["prefer", "avoid"]
                },
                "source_kind": {
                  "type": "string",
                  "enum": ["anonymous-source", "attributable-practitioner", "profile-page"]
                },
                "topic_kind": {
                  "type": "string",
                  "enum": ["generic-ad", "crypto-promotion", "operational-problem"]
                },
                "falsifier_action": {
                  "type": "string",
                  "enum": ["retain", "reject"]
                },
                "falsifier_observation": {
                  "type": "string",
                  "enum": [
                    "reviewed-outcomes-contradict",
                    "no-counterevidence",
                    "reviewed-outcomes-confirm"
                  ]
                }
              }
            },
            "recommendation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "falsifiable_by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "candidate_content_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "citation_ids": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        },
        "promoted_lesson_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "external_write_performed": {
      "type": "boolean"
    }
  }
}
