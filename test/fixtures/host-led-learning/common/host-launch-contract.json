{
  "schema_version": 2,
  "fixture_id": "host-led-learning",
  "behavior_revision": "host-led-learning-v6",
  "fixture_iteration": 7,
  "certification_profile": {
    "id": "ambient-auth-v1",
    "authentication": {
      "claude": {
        "mode": "host-managed",
        "provider": "claude.ai",
        "source": "firstParty",
        "model_api_key_injected": false
      },
      "codex": {
        "mode": "host-managed",
        "provider": "chatgpt",
        "model_api_key_injected": false
      }
    },
    "external_host_state": {
      "policy": "accepted-unpinned",
      "paid_session_scope": "auth-cache-only",
      "copied": false,
      "recursive_scan": false,
      "transient_inspection": true,
      "transient_output_hashing": true,
      "raw_personal_state_persisted": false,
      "personal_state_authority": false
    }
  },
  "runtime": {
    "state_path": ".fixture/learning-state.json",
    "adapter_log_path": ".fixture/adapter-calls.jsonl",
    "adapter_directory": ".fixture/bin",
    "workspace_entries": {
      "common": [
        {
          "source": "common/brain-evidence.json",
          "destination": ".fixture/input/brain-evidence.json"
        },
        {
          "source": "common/fake-search-results.json",
          "destination": ".fixture/input/fake-search-results.json"
        }
      ],
      "claude": [],
      "codex": [
        {
          "source": "codex-project/.agents",
          "destination": ".agents"
        }
      ]
    }
  },
  "host_readable_inputs": {
    "discover_request": "common/requests/discover-opportunities.txt",
    "approval_request": "common/requests/approve-learning.txt",
    "record_only_request": "common/requests/record-only.txt",
    "recover_request": "common/requests/recover-learning.txt",
    "brain_evidence": "common/brain-evidence.json",
    "tool_results": "common/fake-search-results.json",
    "discover_output_schema": "common/discover-output-schema.json",
    "approve_output_schema": "common/approve-output-schema.json",
    "record_only_output_schema": "common/record-only-output-schema.json",
    "recover_output_schema": "common/recover-output-schema.json"
  },
  "roster": {
    "executable": "$NODE $REPO/bin/roster.js",
    "target": "gtm/social-manager#opportunity-discovery",
    "allowed_model_invocations": [
      {
        "verb": "discover",
        "required_argv": [
          "$TARGET",
          "--exact",
          "--json"
        ],
        "log_category": "roster.discover"
      },
      {
        "verb": "context",
        "required_argv": [
          "$TARGET",
          "--query",
          "$DERIVED_QUERY",
          "--json"
        ],
        "log_category": "roster.context"
      }
    ]
  },
  "adapters": [
    {
      "command": "roster-350-fixture-search",
      "log_category": "tool.search",
      "allowed_turns": [
        "discover",
        "record-only"
      ],
      "required_flags": [
        "--query"
      ],
      "repeatable_flags": []
    },
    {
      "command": "roster-350-fixture-run-record",
      "log_category": "evidence.run-record",
      "allowed_turns": [
        "discover",
        "record-only"
      ],
      "required_flags": [
        "--request-hash",
        "--selected-result",
        "--brain-citation"
      ],
      "repeatable_flags": [
        "--brain-citation"
      ]
    },
    {
      "command": "roster-350-fixture-feedback-record",
      "log_category": "evidence.feedback-record",
      "allowed_turns": [
        "discover",
        "record-only"
      ],
      "required_flags": [
        "--run-id",
        "--signal"
      ],
      "repeatable_flags": []
    },
    {
      "command": "roster-350-fixture-dream-status",
      "log_category": "learning.status",
      "allowed_turns": [
        "discover",
        "recover",
        "approve"
      ],
      "required_flags": [],
      "repeatable_flags": []
    },
    {
      "command": "roster-350-fixture-candidate-create",
      "log_category": "learning.candidate-create",
      "allowed_turns": [
        "discover",
        "recover"
      ],
      "required_flags": [
        "--run-id",
        "--feedback-id",
        "--disposition",
        "--source-kind",
        "--topic-kind",
        "--falsifier-action",
        "--falsifier-observation",
        "--skill-challenge"
      ],
      "repeatable_flags": []
    },
    {
      "command": "roster-350-fixture-state-show",
      "log_category": "learning.state-read",
      "allowed_turns": [
        "approve"
      ],
      "required_flags": [],
      "repeatable_flags": []
    },
    {
      "command": "roster-350-fixture-candidate-promote",
      "log_category": "learning.candidate-promote",
      "allowed_turns": [
        "approve"
      ],
      "required_flags": [
        "--candidate-id",
        "--candidate-hash"
      ],
      "repeatable_flags": []
    }
  ],
  "turn_expectations": {
    "discover": {
      "required_log_categories": [
        "roster.discover",
        "roster.context",
        "tool.search",
        "evidence.run-record",
        "evidence.feedback-record",
        "learning.status",
        "learning.candidate-create"
      ],
      "forbidden_log_categories": [
        "learning.state-read",
        "learning.candidate-promote"
      ],
      "terminal_phase": "awaiting_human"
    },
    "record-only": {
      "required_log_categories": [
        "roster.discover",
        "roster.context",
        "tool.search",
        "evidence.run-record",
        "evidence.feedback-record"
      ],
      "forbidden_log_categories": [
        "learning.status",
        "learning.candidate-create",
        "learning.state-read",
        "learning.candidate-promote"
      ],
      "terminal_phase": "recorded"
    },
    "recover": {
      "required_log_categories": [
        "learning.status",
        "learning.candidate-create",
        "roster.context"
      ],
      "forbidden_log_categories": [
        "tool.search",
        "evidence.run-record",
        "evidence.feedback-record",
        "learning.candidate-promote"
      ],
      "terminal_phase": "awaiting_human"
    },
    "approve": {
      "required_log_categories": [
        "learning.status",
        "learning.state-read",
        "learning.candidate-promote",
        "roster.context"
      ],
      "forbidden_log_categories": [
        "tool.search",
        "evidence.run-record",
        "evidence.feedback-record",
        "learning.candidate-create"
      ],
      "terminal_phase": "promoted"
    }
  },
  "claude": {
    "version": "2.1.220",
    "plugin_root": "claude-plugin",
    "plugin_name": "roster-350-host-led-learning",
    "skill_tool_name": "Skill",
    "skill_permission_policy": "exact-fixture-identities-only",
    "skills": [
      {
        "name": "roster-350-fixture-learning-loop",
        "identity": "roster-350-host-led-learning:roster-350-fixture-learning-loop",
        "path": "claude-plugin/skills/roster-350-fixture-learning-loop/SKILL.md",
        "canonical_source": "common/skills/fake-social-search/SKILL.md"
      },
      {
        "name": "fixture-dreamer",
        "identity": "roster-350-host-led-learning:fixture-dreamer",
        "path": "claude-plugin/skills/fixture-dreamer/SKILL.md",
        "canonical_source": "common/skills/dreamer/SKILL.md"
      }
    ],
    "dreamer_invocation_proof": [
      "assistant-tool-use-exact-skill-identity",
      "successful-skill-tool-result",
      "later-adapter-call-with-skill-only-challenge"
    ]
  },
  "codex": {
