    "skills_list": {
      "transport": "stdio-jsonl",
      "required_skill_policy": "repo-scoped-exactly-once-enabled-path-and-bytes",
      "ambient_skill_policy": "accepted-unpinned-non-authoritative",
      "request_sequence": [
        {
          "method": "initialize",
          "id": 1,
          "params": {
            "clientInfo": {
              "name": "roster-350-certification",
              "title": "Roster 350 certification",
              "version": "1.0.0"
            }
          }
        },
        {
          "method": "initialized"
        },
        {
          "method": "skills/list",
          "id": 2,
          "params": {
            "cwds": [
              "$WORKSPACE"
            ],
            "forceReload": true
          }
        }
      ]
    },
    "skills": [
      {
        "name": "roster-350-fixture-learning-loop",
        "path": ".agents/skills/roster-350-fixture-learning-loop/SKILL.md",
        "source": "codex-project/.agents/skills/roster-350-fixture-learning-loop/SKILL.md",
        "canonical_source": "common/skills/fake-social-search/SKILL.md"
      },
      {
        "name": "fixture-dreamer",
        "path": ".agents/skills/fixture-dreamer/SKILL.md",
        "source": "codex-project/.agents/skills/fixture-dreamer/SKILL.md",
        "canonical_source": "common/skills/dreamer/SKILL.md"
      }
    ],
    "prompt_input": {
      "command": [
